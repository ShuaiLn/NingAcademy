{
  "version": 1,
  "patterns": [
    { "id": "email", "source": "[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9-]+([.][a-z0-9-]+)+" },
    { "id": "phone", "source": "(^|[^0-9])([+]?[0-9]{1,3}[ .-]?)?([(][0-9]{2,4}[)]|[0-9]{3})[ .-][0-9]{3,4}[ .-][0-9]{4}([^0-9]|$)" },
    { "id": "identifier", "source": "(^|[^a-z])(student|employee|account|member)[ _-]*(id|number|no[.]?|#)[ ]*[:#=-]?[ ]*[a-z0-9][a-z0-9-]*" },
    { "id": "dob", "source": "(^|[^a-z])(dob|date[ ]+of[ ]+birth|born)[ ]*[:=-]?[ ]*[0-9a-z]" },
    { "id": "identifying-url", "source": "(https?://|www[.])[^ ]*([?&](id|user|email|token|account|member|student|name)=|/(users?|profiles?|accounts?|members?)/)[^ ]+" },
    { "id": "postal-address", "source": "(^|[^0-9])[0-9]{1,6}[ ]+([a-z0-9.'-]+[ ]+){1,5}(street|st|road|rd|avenue|ave|lane|ln|drive|dr|boulevard|blvd|court|ct|way)([., ]|$)" }
  ]
}
